rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'YOUR_ADMIN_EMAIL';
    }

    function validPdf() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 255
        && request.resource.data.type == 'application/pdf'
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 26214400
        && request.resource.data.subject is string
        && request.resource.data.section in ['revision', 'notes', 'contributed']
        && request.resource.data.createdAt is int
        && request.resource.data.uploadedBy == request.auth.uid;
    }

    match /settings/library {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.subjects is list
        && request.resource.data.subjects.size() <= 100;
      allow delete: if false;
    }

    match /pdfs/{pdfId} {
      allow read: if signedIn();
      allow create: if validPdf()
        && request.resource.data.keys().hasOnly([
          'name', 'size', 'type', 'section', 'subject', 'source',
          'storagePath', 'createdAt', 'uploadedBy'
        ])
        && (
          (request.resource.data.section == 'contributed'
            && request.resource.data.storagePath == 'pdfs/community/' + request.auth.uid + '/' + pdfId)
          || (isAdmin()
            && request.resource.data.section in ['revision', 'notes']
            && request.resource.data.storagePath == 'pdfs/admin/' + pdfId)
        );
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.section == 'contributed'
          && resource.data.uploadedBy == request.auth.uid
          && request.resource.data.uploadedBy == resource.data.uploadedBy
          && request.resource.data.storagePath == resource.data.storagePath
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subject']));
      allow delete: if isAdmin()
        || (signedIn()
          && resource.data.section == 'contributed'
          && resource.data.uploadedBy == request.auth.uid);
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }
  }
}
