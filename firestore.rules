rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'sf920336@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function pdfReference(pdfId) {
      return get(/databases/$(database)/documents/pdfs/$(pdfId));
    }

    function validStudyFile() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 255
        && (request.resource.data.type == 'application/pdf'
          || (request.resource.data.section == 'exam-papers'
            && request.resource.data.type in ['image/png', 'image/jpeg']))
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 26214400
        && request.resource.data.subject is string
        && request.resource.data.section in [
          'revision', 'notes', 'contributed', 'exam-papers',
          'portion-1', 'portion-2', 'portion-3', 'portion-4', 'portion-5', 'portion-6'
        ]
        && request.resource.data.createdAt is int
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount > 0
        && request.resource.data.chunkCount <= 34
        && request.resource.data.uploadStatus == 'uploading'
        && request.resource.data.uploadedBy == request.auth.uid;
    }

    function canUploadPdfChunk(pdfId) {
      let pdf = pdfReference(pdfId);
      return signedIn()
        && pdf.data.uploadedBy == request.auth.uid
        && pdf.data.uploadStatus == 'uploading'
        && pdf.data.chunkCount is int
        && request.resource.data.index is int
        && request.resource.data.index >= 0
        && request.resource.data.index < pdf.data.chunkCount
        && request.resource.data.content is bytes
        && request.resource.data.uploadedBy == request.auth.uid
        && (pdf.data.section in ['contributed', 'exam-papers'] || isAdmin());
    }

    function canDeletePdfChunk(pdfId) {
      let pdf = pdfReference(pdfId);
      return isAdmin()
        || (signedIn()
          && pdf.data.section in ['contributed', 'exam-papers']
          && pdf.data.uploadedBy == request.auth.uid
          && pdf.data.uploadStatus == 'uploading'
          && resource.data.uploadedBy == request.auth.uid);
    }

    match /settings/library {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.subjects is list
        && request.resource.data.subjects.size() <= 100;
      allow delete: if false;
    }

    match /pdfs/{pdfId} {
      allow read: if signedIn();
      allow create: if validStudyFile()
        && request.resource.data.keys().hasOnly([
          'name', 'size', 'type', 'section', 'subject', 'source',
          'createdAt', 'uploadedBy', 'chunkCount', 'uploadStatus'
        ])
        && (
          request.resource.data.section in ['contributed', 'exam-papers']
          || (isAdmin() && request.resource.data.section in [
            'revision', 'notes',
            'portion-1', 'portion-2', 'portion-3', 'portion-4', 'portion-5', 'portion-6'
          ])
        );
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.section in ['contributed', 'exam-papers']
          && resource.data.uploadedBy == request.auth.uid
          && request.resource.data.uploadedBy == resource.data.uploadedBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uploadStatus'])
          && resource.data.uploadStatus == 'uploading'
          && request.resource.data.uploadStatus == 'ready');
      allow delete: if isAdmin()
        || (signedIn()
          && resource.data.section in ['contributed', 'exam-papers']
          && resource.data.uploadedBy == request.auth.uid
          && resource.data.uploadStatus == 'uploading');

      match /chunks/{chunkId} {
        allow read: if signedIn()
          && (pdfReference(pdfId).data.uploadStatus == 'ready'
            || (pdfReference(pdfId).data.uploadStatus == 'uploading'
              && pdfReference(pdfId).data.uploadedBy == request.auth.uid));
        allow create: if canUploadPdfChunk(pdfId)
          && request.resource.data.keys().hasAll(['index', 'content', 'uploadedBy'])
          && request.resource.data.keys().hasOnly(['index', 'content', 'uploadedBy']);
        allow update: if false;
        allow delete: if canDeletePdfChunk(pdfId);
      }
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }
  }
}
